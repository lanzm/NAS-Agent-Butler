# ==============================================================================
# NAS-Agent-Butler 环境变量配置模板
# 复制本文件为 .env 并按需填写配置即可运行
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 必填配置：大语言模型 API (OpenAI 兼容规范 / Gemini / DeepSeek 等)
# ------------------------------------------------------------------------------
# OpenAI 兼容接口 Base URL (例如 Google 官方网关、One-API、DeepSeek 官方等)
OPENAI_API_BASE=https://api.openai.com/v1
# 模型 API 密钥
OPENAI_API_KEY=your_api_key_here
# 模型名称 (推荐使用推理快、指令遵循强的模型，如 gemini-flash-lite-latest, gemini-3.8-flash, deepseek-v4-pro)
OPENAI_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------------------
# 2. 必填配置：飞书机器人应用凭证 (在飞书开放平台获取)
# ------------------------------------------------------------------------------
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 飞书机器人名称 (用于卡片标题显示)
BOT_NAME=NAS 智能管家
# 每日定时报表推送时间 (24小时制，例如 08:00)
DAILY_REPORT_TIME=08:00
# 默认天气查询城市 (支持中文名或拼音，如：北京、Shanghai)
DEFAULT_CITY=北京
# 系统交互语言偏好 (zh = 中文, en = English; 默认: zh; 当用户使用英文提问时均会自动用英文应答)
DEFAULT_LANGUAGE=zh

# ------------------------------------------------------------------------------
# 3. 可选扩展插件配置 (留空或不配置时，对应功能将自动关闭，绝不误报)
# ------------------------------------------------------------------------------

# [插件：Aria2 离线下载]
# 若不需要请保持留空
ARIA2_RPC_URL=
ARIA2_RPC_SECRET=

# [插件：Fail2ban 防火墙封禁查询与解封]
# 若部署了基于 Docker 的 Fail2ban（如 security-guard），填入其容器名称
FAIL2BAN_CONTAINER_NAME=
# Fail2ban 默认监控的 Jail 名称 (默认: caddy-services)
FAIL2BAN_JAIL=caddy-services

# [插件：局域网 PC 电源管理 (开机/关机)]
# 是否启用局域网电脑电源控制 (true / false)
ENABLE_PC_POWER=false
# 目标 PC 的物理 MAC 地址 (用于局域网 WOL 开机魔包)
TARGET_PC_MAC=AA:BB:CC:DD:EE:FF
# 目标 PC 的局域网 IP
TARGET_PC_IP=192.168.1.100
# 目标 PC 的 SSH 用户名 (用于远程关机/睡眠)
TARGET_PC_USER=Administrator
# 目标 PC 的 SSH 端口 (默认 22)
TARGET_PC_PORT=22
